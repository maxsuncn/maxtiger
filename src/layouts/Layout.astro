---
import '../styles/global.css';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
}

const {
  title = site.title,
  description = site.description,
  type = 'website',
  publishedTime,
  modifiedTime,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
const personSchema = {
  '@type': 'Person',
  name: site.name,
  url: site.url,
  email: `mailto:${site.email}`,
};
const schema = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title,
      description,
      author: personSchema,
      mainEntityOfPage: canonical,
      datePublished: publishedTime?.toISOString(),
      dateModified: (modifiedTime ?? publishedTime)?.toISOString(),
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: site.name,
      url: site.url,
      description,
      publisher: personSchema,
    };
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content={site.name} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#172331" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="返回首页">
          <span class="brand-mark">虎</span><span>{site.name}</span>
        </a>
        <nav aria-label="主导航">
          <a href="/posts/">文章</a>
          <a href="/about/">关于</a>
          <a class="course-link" href={site.courseUrl}>通卡学学 ↗</a>
        </nav>
      </header>
      <slot />
      <footer class="site-footer">
        <div><strong>{site.name}</strong><span>把复杂技术，讲成能理解、能判断、能行动的方法。</span></div>
        <div class="footer-meta"><a href={`mailto:${site.email}`}>{site.email}</a><span>© {new Date().getFullYear()} Max Tiger</span></div>
      </footer>
    </div>
  </body>
</html>
