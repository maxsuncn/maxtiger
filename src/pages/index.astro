---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { site } from '../data/site';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout>
  <main>
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">TECHNOLOGY · WORK · JUDGMENT</p>
        <h1>不追热点，<br /><em>追问它有什么用。</em></h1>
        <p class="hero-lead">我是科技小虎哥，关注 AI、数字工具和复杂技术如何进入真实工作，把新东西拆成普通人能理解、能判断、能马上试的方法。</p>
        <div class="hero-actions"><a class="button button-dark" href="/posts/">阅读文章</a><a class="text-link" href="/about/">了解我 ↗</a></div>
      </div>
      <aside class="hero-note"><span class="note-index">THE POINT</span><p>每篇内容尽量回答三个问题：</p><ol><li>发生了什么？</li><li>真正的影响是什么？</li><li>今天能怎么用？</li></ol></aside>
    </section>

    <section class="section-block business-block">
      <div class="section-head"><p class="eyebrow">WHAT I DO</p><span class="section-note">内容 · 研究 · 实践</span></div>
      <div class="business-grid">
        <article><span class="business-number">01</span><h2>科技与 AI 内容</h2><p>把复杂技术讲清楚，帮助职场人和普通用户少走弯路。</p></article>
        <article><span class="business-number">02</span><h2>工作方法与判断</h2><p>关注工具背后的流程、成本、边界和真实应用，而不是工具清单。</p></article>
        <article><span class="business-number">03</span><h2>学习与知识产品</h2><p>通过通卡学学，把输入变成复述、行动和复盘。</p><a class="read-link" href={site.courseUrl}>进入通卡学学 ↗</a></article>
      </div>
    </section>

    <section class="section-block">
      <div class="section-head"><p class="eyebrow">LATEST DISPATCHES</p><a class="text-link" href="/posts/">全部文章 ↗</a></div>
      <div class="post-grid">
        {posts.slice(0, 3).map((post) => <PostCard title={post.data.title} summary={post.data.summary} date={post.data.date} topic={post.data.topics[0]} readingTime={post.data.readingTime} href={`/posts/${post.id}/`} />)}
      </div>
    </section>

    <section class="section-block topics-strip"><div><p class="eyebrow">AREAS OF FOCUS</p><h2>技术不是答案，<br /><em>是新的问题入口。</em></h2></div><div class="topic-list">{site.topics.map((topic) => <span>#{topic}</span>)}</div></section>
  </main>
</Layout>
