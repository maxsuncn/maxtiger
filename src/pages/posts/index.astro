---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="文章｜科技小虎哥" description="科技小虎哥关于 AI、数字工具、工作方法和学习方法的长期记录。">
  <main class="listing-wrap">
    <div class="listing-intro"><p class="eyebrow">THE ARCHIVE</p><h1>文章</h1><p>不追求解释所有热点，只记录值得理解、值得判断、值得实践的内容。</p></div>
    <div class="post-feed">
      {posts.map((post, index) => <article class="post-row">
        <span class="post-row-index">{String(index + 1).padStart(2, '0')}</span>
        <div class="post-row-meta"><span>{post.data.topics[0] ?? '记录'}</span><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString('zh-CN').replaceAll('/', '.')}</time></div>
        <div class="post-row-body"><h2><a href={`/posts/${post.id}/`}>{post.data.title}</a></h2><p>{post.data.summary}</p></div>
        <a class="post-row-arrow" href={`/posts/${post.id}/`} aria-label={`阅读：${post.data.title}`}>↗</a>
      </article>)}
    </div>
  </main>
</Layout>
