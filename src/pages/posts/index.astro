---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';

const posts = (await getCollection('posts')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Layout title="文章｜科技小虎哥" description="科技小虎哥关于 AI、数字工具、工作方法和学习方法的长期记录。">
  <main class="listing-wrap">
    <div class="listing-intro"><p class="eyebrow">THE ARCHIVE</p><h1>文章</h1><p>不追求解释所有热点，只记录值得理解、值得判断、值得实践的内容。</p></div>
    <div class="post-grid">{posts.map((post) => <PostCard title={post.data.title} summary={post.data.summary} date={post.data.date} topic={post.data.topics[0]} href={`/posts/${post.id}/`} />)}</div>
  </main>
</Layout>
